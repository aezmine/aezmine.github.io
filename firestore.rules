rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Portfolio Configuration ──────────────────────────────
    // Public read: Anyone can view your latest resume link & work experience.
    // Secure write: ONLY authenticated admin (mengcb@gmail.com) can save updates.
    match /portfolio_config/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'mengcb@gmail.com';
    }

    // ── Default Lock ─────────────────────────────────────────
    // Protect all other collections/documents.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
